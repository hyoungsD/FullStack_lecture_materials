// 16장 — 상품 이미지 + 배송 상태머신.
// 15장 스키마에 ProductImage(1:N)만 더한다.
// 배송 상태(SHIPPED/DONE)는 이미 15장 OrderStatus enum에 정의돼 있다 — 이 장에서 비로소 쓴다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DONE
  CANCELLED
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  name      String
  role      Role       @default(BUYER)
  products  Product[]
  orders    Order[]
  cartItems CartItem[]
  createdAt DateTime   @default(now())
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id          Int            @id @default(autoincrement())
  name        String
  description String
  price       Int
  stock       Int            @default(0)
  viewCount   Int            @default(0)
  seller      User           @relation(fields: [sellerId], references: [id])
  sellerId    Int
  categories  Category[]
  images      ProductImage[] // 16장에서 추가 (1:N)
  orderItems  OrderItem[]
  cartItems   CartItem[]
  createdAt   DateTime       @default(now())
}

// 업로드한 이미지의 메타데이터만 DB에. 실제 파일은 uploads/ 에 떨어진다.
model ProductImage {
  id         Int     @id @default(autoincrement())
  storedName String // 디스크에 저장된 무작위 파일명
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  Int
}

model CartItem {
  id        Int     @id @default(autoincrement())
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  quantity  Int

  @@unique([userId, productId])
}

model Order {
  id         Int         @id @default(autoincrement())
  buyer      User        @relation(fields: [buyerId], references: [id])
  buyerId    Int
  status     OrderStatus @default(PENDING)
  totalPrice Int
  items      OrderItem[]
  payment    Payment?
  createdAt  DateTime    @default(now())
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  quantity  Int
  unitPrice Int
}

model DailyStat {
  id           Int      @id @default(autoincrement())
  day          String   @unique
  productCount Int
  totalStock   Int
  createdAt    DateTime @default(now())
}

model Payment {
  id      Int      @id @default(autoincrement())
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId Int      @unique
  amount  Int
  method  String
  paidAt  DateTime @default(now())
}
