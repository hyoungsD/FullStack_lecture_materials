# 로컬 PostgreSQL과 Redis(Homebrew)를 가리킨다 — PG 사용자·비밀번호는 본인 값으로 바꾼다.
# DB(nest_shop_16)가 없으면 prisma migrate가 자동으로 만든다. 안 되면 DBeaver로 먼저 만든다.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nest_shop_16?schema=public"

JWT_SECRET="dev-secret-change-me"

REDIS_HOST=localhost
REDIS_PORT=6379

PORT=3000
